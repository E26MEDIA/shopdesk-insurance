{
  "name": "insurance-shop",
  "version": "0.1.20",
  "private": true,
  "author": {
    "name": "E26 Media",
    "url": "https://insurance.e26media.com"
  },
  "description": "Insurance Desk desktop app for insurance and PUC shops",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "bash scripts/run-desktop.sh",
    "desktop:dist": "cross-env SHOPDESK_DESKTOP=1 next build && node scripts/prepare-standalone.cjs && cross-env ELECTRON_RUN_AS_NODE= electron-builder",
    "desktop:dist:win": "cross-env SHOPDESK_DESKTOP=1 next build --webpack && node scripts/prepare-standalone.cjs && cross-env ELECTRON_RUN_AS_NODE= electron-builder --win",
    "desktop:open": "bash scripts/run-desktop.sh",
    "office-server": "node server/office-server.cjs",
    "site:dev": "cd admin && npm run dev",
    "site:build": "cd admin && npm run build",
    "admin:dev": "cd admin && npm run dev",
    "admin:build": "cd admin && npm run build",
    "admin:seed": "cd admin && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "jose": "^6.0.10",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.shopdesk.insurance",
    "productName": "Insurance Desk",
    "executableName": "ShopDesk",
    "copyright": "Copyright © E26 Media",
    "asar": true,
    "afterAllArtifactBuild": "./scripts/after-all-artifact-build.cjs",
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "server/**/*",
      "!server/**/*.test.cjs",
      "package.json",
      "node_modules/jose/**/*"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": ".",
        "filter": [
          "standalone/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ShopDesk-Setup-${version}.${ext}",
      "icon": "resources/icon.ico",
      "legalTrademarks": "Insurance Desk",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": "E26 Media"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "packElevateHelper": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Insurance Desk",
      "uninstallDisplayName": "Insurance Desk",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
