# E26 Insurance Desk — Desktop licensing

# Licensing API base URL (desktop app)
E26_LICENSE_API_URL=https://insurance.e26media.com/api/v1

# Public key for offline JWT verification (same as admin LICENSE_SIGNING_PUBLIC_KEY)
LICENSE_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Set to 1 only for local dev without licensing server
# SHOPDESK_SKIP_LICENSE=1
