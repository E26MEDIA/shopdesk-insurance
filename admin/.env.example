# E26 Insurance Admin — environment variables
# Copy to admin/.env and fill in values

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/e26_insurance_admin

# Random secret for session signing (32+ chars)
AUTH_SECRET=change-me-to-a-long-random-string

# Ed25519 keys — generated by `npm run db:seed` in admin/
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Public URL of this site (customer website + admin)
NEXT_PUBLIC_APP_URL=https://insurance.e26media.com

# Optional: direct .exe download URL (overrides database value)
NEXT_PUBLIC_INSURANCE_DESK_DOWNLOAD_URL=
NEXT_PUBLIC_INSURANCE_DESK_VERSION=0.1.0

# Google Form — enquiry form on the customer website
NEXT_PUBLIC_GOOGLE_FORM_ACTION_URL=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_FULL_NAME=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_BUSINESS_NAME=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_MOBILE=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_EMAIL=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_CITY=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_STATE=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_NUM_USERS=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_CURRENT_SOFTWARE=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_MESSAGE=

# Seed script defaults (first super admin)
SEED_ADMIN_EMAIL=admin@e26media.com
SEED_ADMIN_PASSWORD=ChangeMeNow!123

# Optional — future Google Sheets sync (not used yet)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
